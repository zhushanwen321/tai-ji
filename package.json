{
  "name": "taiji",
  "version": "0.11.15",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @taiji/electron dev",
    "build": "pnpm --filter @taiji/electron build",
    "lint": "eslint . --max-warnings 0",
    "prepare": "bash .githooks/install-hooks.sh",
    "postinstall": "bash scripts/fix-node-pty-permissions.sh",
    "build:e2e": "pnpm --filter @taiji/electron build:e2e",
    "test": "pnpm --no-bail run test:small; s=$?; pnpm --no-bail run test:heavy; e=$?; exit $((s|e))",
    "test:small": "pnpm --filter ./packages/shared --filter ./packages/state-machine --filter ./packages/extension-protocol --filter ./packages/pi-rpc --filter ./packages/dom-core --filter ./packages/session-core --filter ./packages/session-delivery --filter ./packages/subagent-engine-sdk --filter ./packages/zcode-session-source --filter ./packages/pi-subagent-cli --workspace-concurrency=3 --no-bail run test",
    "test:heavy": "pnpm --filter ./packages/renderer --filter ./packages/runtime --filter ./packages/ui --filter ./packages/subagent-core --filter ./packages/zcode-subagent-cli --filter ./packages/mobile-renderer --filter ./packages/core --filter ./apps/electron --workspace-concurrency=1 --no-bail run test",
    "test:integration": "TAIJI_TEST_INTEGRATION=1 pnpm --no-bail run test:small; s=$?; TAIJI_TEST_INTEGRATION=1 pnpm --no-bail run test:heavy; e=$?; exit $((s|e))",
    "test:domain": "node scripts/run-domain-tests.mjs",
    "test:e2e": "playwright test",
    "test:taste-lint": "pnpm exec vitest run --config taste-lint/vitest.config.ts taste-lint",
    "test:resources-plugins": "pnpm exec vitest run --config resources/plugins/scheduler-manager/vitest.config.ts",
    "dev:smoke": "node scripts/dev-smoke.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release:npm": "pnpm --filter @zhushanwen/extension-protocol build && changeset publish",
    "extensions:typecheck": "cd extensions && npx tsc --noEmit",
    "extensions:lint": "node scripts/check-stale-ctx-audit-coverage.mjs && npx eslint extensions/",
    "extensions:test": "pnpm -r --filter '@zhushanwen/pi-*' --workspace-concurrency=1 test",
    "extensions:test:isolated": "pnpm -r --filter '@zhushanwen/pi-*' --workspace-concurrency=1 test:isolated",
    "gen:builtin-providers": "node packages/runtime/scripts/gen-builtin-providers.mjs",
    "prebuild": "node packages/runtime/scripts/gen-builtin-providers.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.27.7",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "jscpd": "5.4.0",
    "typescript": "^5.8",
    "typescript-eslint": "^8.59.2",
    "vue-eslint-parser": "^10.4.1",
    "ws": "^8.21.0"
  }
}
