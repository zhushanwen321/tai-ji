{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@zhushanwen/subagent-core/testing/*.ts": ["../packages/subagent-core/src/*.ts"],
      "@zhushanwen/subagent-core/*.ts": ["../packages/subagent-core/src/*.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    "**/__tests__",
    "**/tests/**",
    "**/vitest.config.ts",
    "**/workflows/**",
    "**/examples/**"
  ]
}
