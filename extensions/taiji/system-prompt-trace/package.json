{
  "name": "@zhushanwen/pi-system-prompt-trace",
  "version": "0.1.6",
  "description": "System prompt trace extension: appends xyz:system-prompt entries to the session JSONL whenever the effective system prompt is established or changes",
  "type": "module",
  "main": "index.ts",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "trace"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src/**/*.ts",
    "README.md"
  ],
  "xyz-agent": {
    "role": "taiji"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@zhushanwen/pi-ext-guards": "workspace:*",
    "@zhushanwen/pi-extension-logger": "workspace:*"
  }
}
