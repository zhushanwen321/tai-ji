{
  "name": "@zhushanwen/pi-canvas",
  "version": "0.4.5",
  "description": "Problem-solving canvas toolface for pi: six deferred canvas_* tools bridging the agent to the taiji runtime CanvasService via the CANVAS_MARKER select channel (problem-solve-canvas)",
  "type": "module",
  "main": "index.ts",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "canvas"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src/**/*.ts",
    "README.md",
    "skills/"
  ],
  "taiji": {
    "role": "taiji"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run --pool=threads"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "typebox": "1.3.27"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@zhushanwen/extension-protocol": "workspace:*",
    "@zhushanwen/pi-ext-guards": "workspace:*",
    "@zhushanwen/pi-extension-logger": "workspace:*",
    "@zhushanwen/subagent-core": "workspace:*"
  }
}
