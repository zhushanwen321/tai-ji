{
  "name": "@zhushanwen/pi-agent-ext",
  "version": "1.2.1",
  "description": "taiji extension for Pi — internal host commands for extension reload and system prompt fetch",
  "type": "module",
  "main": "src/index.ts",
  "taiji": {
    "role": "taiji"
  },
  "pi": {
