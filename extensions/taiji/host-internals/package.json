{
  "name": "@zhushanwen/pi-host-internals",
  "version": "1.5.0",
  "description": "taiji extension for Pi — internal host protocol facilities: host commands (system prompt fetch, session tree nav) and client UUID ↔ user entry ID mapping",
  "type": "module",
  "main": "src/index.ts",
  "taiji": {
    "role": "taiji"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "extension",
    "host",
    "internal",
    "msg-id",
    "client-uuid",
    "mapping"
  ],
  "license": "MIT",
  "files": [
    "src/",
    "index.ts"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0"
  },
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run --pool=threads"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@zhushanwen/pi-extension-logger": "workspace:*"
  }
}
