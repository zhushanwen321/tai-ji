{
  "name": "@zhushanwen/pi-ask-user",
  "version": "7.1.3",
  "description": "Inline adaptive ask_user tool for Pi — single/multi-question structured input with split-pane preview and an inline free-text editor.",
  "type": "module",
  "main": "index.ts",
  "xyz-agent": {
    "role": "universal"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "ask",
    "ask_user",
    "interactive"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xyz-agent/extension-protocol": "workspace:*",
    "@zhushanwen/pi-ext-guards": "workspace:*",
    "@zhushanwen/pi-extension-logger": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "fast-check": "^4.9.0",
    "typebox": "*",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
