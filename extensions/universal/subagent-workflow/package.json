{
  "name": "@zhushanwen/pi-subagent-workflow",
  "version": "9.2.1",
  "type": "module",
  "main": "index.ts",
  "description": "Unified subagent execution and multi-agent workflow orchestration for Pi — spawned-process agent runtime with sync/background modes, stateful workflow management with persistence, state machine, and execution tracing.",
  "keywords": [
    "pi-package",
    "extension",
    "subagent",
    "agent-runtime",
    "workflow",
    "orchestration",
    "multi-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.ts",
    "skills/",
    "scripts/",
    "relay/",
    "src/index.ts",
    "src/jsonl-run-store.ts",
    "src/session-lifecycle.ts",
    "src/model-events.ts",
    "src/subagents-events.ts",
    "src/workflow-events.ts",
    "src/workflow-notify.ts",
    "src/host/",
    "src/injectors/",
    "src/interface/"
  ],
  "taiji": {
    "role": "universal",
    "subagentEngines": [
      "pi",
      "zcode"
    ],
    "startupConfig": [
      {
        "path": "subagents/config.json",
        "content": {
          "version": 1,
          "maxConcurrent": 6
        }
      }
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:isolated": "env $(env | grep -o '^PI_SUBAGENT_[A-Z_]*' | sed 's/^/-u /' | tr '\n' ' ') vitest run"
  },
  "dependencies": {
    "@zhushanwen/extension-protocol": "workspace:*",
    "@zhushanwen/session-delivery": "workspace:*",
    "@zhushanwen/pi-ext-guards": "workspace:*",
    "@zhushanwen/pi-extension-logger": "workspace:*",
    "@zhushanwen/pi-notify-ledger-host": "workspace:*",
    "@zhushanwen/subagent-core": "workspace:*",
    "@zhushanwen/pi-subagent-cli": "workspace:*",
    "@zhushanwen/zcode-subagent-cli": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@zhushanwen/pi-pending-notifications": "workspace:*",
    "@zhushanwen/pi-structured-output": "workspace:*",
    "typebox": "1.3.27"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@zhushanwen/pi-structured-output": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@zhushanwen/subagent-engine-sdk": "workspace:*",
    "vitest": "^4.1.8"
  }
}
