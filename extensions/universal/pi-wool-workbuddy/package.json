{
  "name": "@zhushanwen/pi-wool-workbuddy",
  "version": "0.1.0",
  "description": "Wool provider extension for WorkBuddy (Tencent) — session header family + client fingerprint, OAuth flow with authorization-window-only local callback listener, check-in execution. Skeleton: protocol implementation lands in the u-workbuddy unit.",
  "type": "module",
  "main": "index.ts",
  "taiji": {
    "role": "universal"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "wool",
    "workbuddy",
    "provider"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src/**/*.ts",
    "snapshots/*.json",
    "vitest.config.ts"
  ],
  "scripts": {
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zhushanwen/pi-wool-shared": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
