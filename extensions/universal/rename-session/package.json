{
  "name": "@zhushanwen/pi-rename-session",
  "version": "0.14.2",
  "type": "module",
  "main": "index.ts",
  "taiji": {
    "role": "universal",
    "startupConfig": [
      {
        "path": "config/rename-session-ext-config.json",
        "content": {
          "enabled": false,
          "model": {
            "type": "ref",
            "ref": ""
          },
          "mode": "first-stop",
          "maxTitleLength": 50,
          "thinkingLevel": "off",
          "style": "slug",
          "customInstruction": ""
        }
      }
    ]
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "vitest run --pool=threads",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zhushanwen/extension-protocol": "workspace:*",
    "@zhushanwen/pi-ext-guards": "workspace:*",
    "@zhushanwen/pi-extension-logger": "workspace:*",
    "@zhushanwen/pi-llm-shared": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "vitest": "^4.1.8"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "skills/",
    "vitest.config.ts"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "typebox": "1.3.27"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
