    {
      "text": "跑一个两路 fan-out 的 workflow：",
      "toolCalls": [
        {
          "name": "workflow_run",
          "args": {
            "name": "<REPLACE_WITH_ABSOLUTE_PATH>/fanout-canary.workflow.js",
            "model": "mockllm/mock-sub-a",
            "args": { "tasks": ["第一路：报出你剧本里的 canary", "第二路：报出你剧本里的 canary"] }
          }
        }
      ],
      "stopReason": "toolUse"
    },
    { "text": "workflow 已派发，等待两路结果汇总（WORKFLOW-DISPATCHED）。", "stopReason": "stop" },
    { "text": "parent-notified", "stopReason": "stop" },
    { "text": "parent-idle-1", "stopReason": "stop" },
    { "text": "parent-idle-2", "stopReason": "stop" },
    { "text": "parent-idle-3", "stopReason": "stop" }
  ],
  "mockllm/mock-sub-a": [
    { "toolCalls": [{ "name": "structured-output", "args": { "summary": "FANOUT_MEMBER_STEP_0_CANARY" } }], "stopReason": "toolUse" },
    { "toolCalls": [{ "name": "structured-output", "args": { "summary": "FANOUT_MEMBER_STEP_1_CANARY" } }], "stopReason": "toolUse" },
    { "toolCalls": [{ "name": "structured-output", "args": { "summary": "FANOUT_MEMBER_STEP_2_CANARY" } }], "stopReason": "toolUse" },
    { "toolCalls": [{ "name": "structured-output", "args": { "summary": "FANOUT_MEMBER_STEP_3_CANARY" } }], "stopReason": "toolUse" },
    { "toolCalls": [{ "name": "structured-output", "args": { "summary": "FANOUT_MEMBER_STEP_4_CANARY" } }], "stopReason": "toolUse" },
    { "toolCalls": [{ "name": "structured-output", "args": { "summary": "FANOUT_MEMBER_STEP_5_CANARY" } }], "stopReason": "toolUse" },
    { "toolCalls": [{ "name": "structured-output", "args": { "summary": "FANOUT_MEMBER_STEP_6_CANARY" } }], "stopReason": "toolUse" },
    { "toolCalls": [{ "name": "structured-output", "args": { "summary": "FANOUT_MEMBER_STEP_7_CANARY" } }], "stopReason": "toolUse" }
