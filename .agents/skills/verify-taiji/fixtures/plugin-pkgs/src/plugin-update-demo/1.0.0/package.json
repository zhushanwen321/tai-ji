{
  "name": "plugin-update-demo",
  "version": "1.0.0",
  "description": "verify-taiji fixture: plugin update chain (S26) v1.0.0 baseline",
  "displayName": "Update Demo",
  "type": "module",
  "taijiPlugin": {
    "manifestVersion": 1,
    "main": "index.js",
    "activationEvents": [
      "onStartupFinished"
    ],
    "trustLevel": "sandbox",
    "namespace": "update-demo",
    "capabilities": [
      "network.http"
    ],
    "readPaths": [
      "Documents/taiji-verify-update-demo.json"
    ],
    "permissions": [
      "providers.write"
    ]
  }
}
