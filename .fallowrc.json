{
  "dynamicallyLoaded": [
    "extensions/*/index.ts",
    "taste-lint/**/*.test.mjs"
  ],
  "ignoreExports": [
    {
      "file": "extensions/shared/file-lock/src/file-lock.ts",
      "exports": [
        "DEFAULT_RETRY_BUDGET_MS",
        "DEFAULT_RETRY_DELAY_MS",
        "DEFAULT_STALE_MS",
        "SyncFileLockOptions",
        "withFileLockSync"
      ]
    },
    {
      "file": "extensions/universal/subagent-workflow/src/interface/subagent-actions.ts",
      "exports": [
        "*"
      ]
    },
    {
      "file": "packages/core/src/domain/chat/store.ts",
      "exports": [
        "_FacetCoversAllKeys",
        "_FacetsDisjoint"
      ]
    },
    {
      "file": "packages/renderer/src/stores/chat.ts",
      "exports": [
        "DEFAULT_STREAMING_IDLE_TIMEOUT_MS"
      ]
    },
    {
      "file": "packages/runtime/src/infra/pi/session-file-utils.ts",
      "exports": [
        "persistBindingSidecar",
        "readBindingSidecar"
      ]
    },
    {
      "file": "packages/runtime/src/services/plugin-service/plugin-types.ts",
      "exports": [
        "*"
      ]
    }
  ],
  "ignoreDependencies": [
    "node-pty",
    "@taiji/frontend",
    "@taiji/runtime"
  ],
  "usedClassMembers": [
    "getStreamSink"
  ],
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 15,
    "maxCrap": 30,
    "ignore": [
      "**/*.test.ts",
      "**/*.test.mts",
      "**/*.test.mjs",
      "**/__tests__/**",
      "**/dist/**",
      "**/*.d.ts"
    ]
  },
  "rules": {
    "circular-dependencies": "error",
    "unresolved-imports": "error",
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-enum-members": "warn",
    "unused-class-members": "warn",
    "unused-dependencies": "warn",
    "unused-dev-dependencies": "warn",
    "unlisted-dependencies": "warn",
    "duplicate-exports": "warn",
    "private-type-leaks": "warn",
    "type-only-dependencies": "warn",
    "test-only-dependencies": "warn",
    "re-export-cycle": "warn",
    "boundary-violation": "warn",
    "coverage-gaps": "warn",
    "stale-suppressions": "off"
  },
  "audit": {
    "gate": "new-only"
  },
  "ignoreUnresolvedImports": [
    "./helpers/rpc-client-mock"
  ]
}