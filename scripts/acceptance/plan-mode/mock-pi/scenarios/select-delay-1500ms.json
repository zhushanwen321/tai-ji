{
  "name": "select-delay-1500ms",
  "description": "S3 稳定窗靶向构造：plan-state 落盘 → select 登记延迟 1.5s（persist→pending 间隙）。<2s 稳定窗覆盖域且可观测；间隙内 degraded 公式恒真，断言「间隙内零渲染」（U0 CDP 断言 zero-render）。超 2s 形态归设计 R8，不在本断言域。",
  "params": {
    "selectRegisterDelayMs": 1500,
    "abortMode": "dissolve"
  },
  "onPrompt": {
    "planStateEntry": {
      "isActive": true,
      "planFilePath": "/fixture/plans/fixture-requirement/plan.md",
      "requirement": "给设置页加主题切换",
      "templateName": null,
      "skills": [],
      "docs": [{ "fileName": "plan.md", "absPath": "/fixture/plans/fixture-requirement/plan.md", "sourceSkill": "", "version": 1 }],
      "reviewState": "awaiting"
    },
    "assistant": ["修订完成，重新提交审批。"],
    "select": {
      "kind": "plan-review",
      "id": "pr-delay-1500",
      "docs": [{ "fileName": "plan.md", "absPath": "/fixture/plans/fixture-requirement/plan.md", "sourceSkill": "", "version": 1 }]
    },
    "agentEnd": false
  },
  "onAbort": {
    "planStateEntry": null,
    "assistant": ["已停止审阅流程。"],
    "agentEnd": true
  }
}
